// Exarch niri config. Full reference: https://github.com/niri-wm/niri/wiki
// Mod = Super (Windows key). Press Mod+Shift+/ for the keybind cheat sheet.

input {
    keyboard {
        xkb {
            // German layout by default; change to "us" etc. if needed.
            layout "de"
        }
        numlock
    }

    // Raw, Windows-style mouse: no acceleration.
    mouse {
        accel-profile "flat"
    }

    touchpad {
        tap
        natural-scroll
    }

    focus-follows-mouse max-scroll-amount="0%"
}

// Example for a 360 Hz monitor. Find your output name with: niri msg outputs
// output "DP-1" {
//     mode "1920x1080@360.000"
//     variable-refresh-rate on-demand=true
// }

layout {
    gaps 12
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#9a5cff"
        inactive-color "#2a1a4a"
    }

    border {
        off
    }

    shadow {
        on
        softness 30
        spread 4
        offset x=0 y=6
        color "#7a2fe055"
    }
}

prefer-no-csd

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
}

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot %Y-%m-%d %H-%M-%S.png"

// Wallpaper, shell (Noctalia or fallback bar), idle lock, polkit agent
spawn-at-startup "exarch-shell"
// One-time setup on first login (theme, menu, welcome screen)
spawn-at-startup "exarch-firstlogin"

window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

window-rule {
    match app-id="^org\\.kde\\.polkit-kde-authentication-agent-1$"
    open-floating true
}

window-rule {
    match app-id="^exarch-welcome$"
    open-floating true
    default-column-width { fixed 980; }
    default-window-height { fixed 760; }
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Apps
    Mod+Return hotkey-overlay-title="Terminal" { spawn "kitty"; }
    Mod+T { spawn "kitty"; }
    Mod+D hotkey-overlay-title="Launcher" { spawn "exarch-launcher"; }
    Mod+E { spawn "nautilus"; }
    Mod+Alt+L hotkey-overlay-title="Lock screen" { spawn "exarch-lock"; }

    Mod+Q { close-window; }
    Mod+O repeat=false { toggle-overview; }

    // Focus (arrows or vim keys)
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    // Move
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+L     { move-column-right; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+J     { move-window-down; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }

    // Workspaces
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }

    // Column layout
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }
    Mod+V { toggle-window-floating; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Plus  { set-column-width "+10%"; }

    // Screenshots
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // Media keys
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext        allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev        allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
}
