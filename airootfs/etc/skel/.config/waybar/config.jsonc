// Fallback bar (only used when Noctalia isn't installed)
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 6,
  "modules-left": ["custom/exarch", "niri/workspaces", "niri/window"],
  "modules-center": ["clock"],
  "modules-right": ["custom/gpu", "cpu", "memory", "network", "pulseaudio", "battery", "tray"],

  "custom/exarch": {
    "format": "  EXARCH",
    "tooltip": false,
    "on-click": "kitty --class exarch-welcome -e exarch welcome"
  },
  "niri/workspaces": { "format": "{index}" },
  "niri/window": { "max-length": 50 },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "custom/gpu": {
    "exec": "nvidia-smi --query-gpu=utilization.gpu,temperature.gpu --format=csv,noheader,nounits 2>/dev/null | awk -F', ' '{print \"󰢮 \"$1\"% \"$2\"°\"}'",
    "interval": 5,
    "tooltip": false
  },
  "cpu": { "format": " {usage}%", "interval": 5 },
  "memory": { "format": " {percentage}%", "interval": 10 },
  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈀 wired",
    "format-disconnected": "󰖪 offline",
    "on-click": "kitty -e nmtui"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 muted",
    "format-icons": { "default": ["", "", ""] },
    "on-click": "pavucontrol"
  },
  "battery": { "format": "{icon} {capacity}%", "format-icons": ["", "", "", "", ""] },
  "tray": { "spacing": 8 }
}
