#!/usr/bin/env bash
# Runs once per user at first login (niri via spawn-at-startup, Plasma via
# autostart): dark theme, violet accents, wallpaper, tool menu, welcome screen.
set -uo pipefail

marker="${XDG_CONFIG_HOME:-$HOME/.config}/exarch/firstlogin.done"
[[ -f "$marker" ]] && exit 0
wall=/usr/share/exarch/branding/wallpaper-1080p.png

# GTK / portal dark mode (niri and Plasma)
if command -v gsettings >/dev/null; then
  gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null
  gsettings set org.gnome.desktop.interface icon-theme 'Papirus-Dark' 2>/dev/null
  gsettings set org.gnome.desktop.interface cursor-theme 'Adwaita' 2>/dev/null
  gsettings set org.gnome.desktop.interface font-name 'Noto Sans 10' 2>/dev/null
  gsettings set org.gnome.desktop.interface monospace-font-name 'JetBrainsMono Nerd Font 10' 2>/dev/null
fi

if [[ "${XDG_CURRENT_DESKTOP:-}" == *KDE* ]]; then
  sleep 3  # let plasmashell finish starting
  plasma-apply-lookandfeel -a org.kde.breezedark.desktop
  plasma-apply-colorscheme Exarch
  plasma-apply-wallpaperimage "$wall"
  kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper \
    --group org.kde.image --group General --key Image "file://$wall"
  kwriteconfig6 --file kdeglobals --group Icons --key Theme Papirus-Dark
fi

# Tool launchers grouped by DevSecOps stage, for any app launcher
command -v exarch >/dev/null && exarch menu sync >/dev/null 2>&1

mkdir -p "$(dirname "$marker")"
touch "$marker"

# Welcome screen (once)
sleep 1
if command -v kitty >/dev/null && command -v exarch >/dev/null; then
  kitty --class exarch-welcome -e exarch welcome &
fi
