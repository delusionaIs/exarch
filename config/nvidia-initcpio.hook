# Rebuild the initramfs when the NVIDIA driver changes (its modules are
# loaded early for KMS). From the ArchWiki NVIDIA page.
[Trigger]
Operation=Install
Operation=Upgrade
Operation=Remove
Type=Package
Target=nvidia-open
Target=nvidia-open-dkms
Target=nvidia-open-lts
Target=nvidia-lts-open
Target=nvidia-utils
Target=linux
Target=linux-lts
Target=linux-zen

[Action]
Description=Updating NVIDIA module in initcpio
Depends=mkinitcpio
When=PostTransaction
NeedsTargets
Exec=/bin/sh -c 'while read -r trg; do case $trg in linux*) exit 0; esac; done; /usr/bin/mkinitcpio -P'
